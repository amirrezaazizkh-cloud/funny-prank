
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>سیستم شوخی 😂</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;background:#101010;color:white;
  font-family:tahoma,Arial;text-align:center;
  min-height:100vh;display:flex;
  align-items:center;justify-content:center;
  padding:20px;
}
main{max-width:420px;width:100%}
h1{color:#ff3434}
#message{font-size:22px;margin:35px 0;min-height:70px}
button{
  border:0;border-radius:12px;padding:15px 25px;
  background:#ff3434;color:white;font-size:18px;
  cursor:pointer;margin:8px;
}
#progress{color:#aaa;font-size:14px}
</style>
</head>
<body>
<main>
<h1>😂 سیستم شوخی فعال شد!</h1>
<div id="message">آماده‌ای؟ 😈</div>
<div id="progress"></div>
<button onclick="start()">شروع شوخی</button>
<button onclick="release()">خروج</button>
</main>
<script>
const messages=[
"در حال بررسی میزان شیطنت شما...",
"یک دوست شیطون پیدا شد! 😂",
"در حال محاسبه میزان خنده...",
"نتیجه بررسی: شما گول خوردید!",
"😂😂😂 شوخی بود! آزاد هستی."
];
let timer;
let index=0;

function start(){
 clearInterval(timer);
 index=0;
 document.getElementById("message").textContent=messages[index];
 document.getElementById("progress").textContent="1 از 5";
 timer=setInterval(()=>{
   index++;
   if(index>=messages.length){
     clearInterval(timer);
     return;
   }
   document.getElementById("message").textContent=messages[index];
   document.getElementById("progress").textContent=(index+1)+" از 5";
 },2000);
}
function release(){
 clearInterval(timer);
 document.getElementById("message").textContent=
 "آزاد شدی! 😂 شوخی بود.";
 document.getElementById("progress").textContent="";
}
</script>
</body>
</html>
